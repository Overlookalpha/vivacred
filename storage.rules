rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /comprovantes/{userId}/{fileName} {
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
